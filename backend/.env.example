PORT=8000
DATABASE_URL="mysql://root:@127.0.0.1:3306/chatbot_llm"
FRONTEND_URL="http://localhost:5173"

# Gemini AI (SDK @google/genai)
GEMINI_API_KEY=""

# (Opsional) Proxy untuk bypass geo-blocking Google Gemini di VPS luar negeri (Hong Kong/China)
# Jika menggunakan Cloudflare WARP Proxy Mode di VPS: socks5://127.0.0.1:40000
# GEMINI_PROXY="socks5://127.0.0.1:40000"
# (Opsional) Reverse proxy endpoint / Cloudflare Worker jika tidak memakai WARP
# GEMINI_BASE_URL="https://my-gemini-proxy.workers.dev"

# Rantai Model Fallback Aktif (diurutkan dari kualitas terbaik hingga kuota terbesar)
# Total kapasitas kuota harian: ~29.880 RPD
GEMINI_MODELS="gemini-3.8-flash,gemini-3.6-flash,gemini-3-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemma-4-31b-it,gemma-4-26b-it"

# Telegram Bot
TELEGRAM_BOT_TOKEN=""

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="digo_webhook_secret"
WHATSAPP_API_VERSION="v18.0"

# Redis (untuk Queue BullMQ - siap deploy di Ubuntu)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
