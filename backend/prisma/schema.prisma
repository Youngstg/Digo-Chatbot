generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Service {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name           String           @db.VarChar(255)
  description    String           @db.Text
  starting_price Decimal          @default(0.00) @db.Decimal(15, 2)
  duration       String           @db.VarChar(255)
  is_active      Boolean          @default(true)
  created_at     DateTime?        @default(now()) @db.Timestamp(0)
  updated_at     DateTime?        @updatedAt @db.Timestamp(0)
  features       ServiceFeature[]
  pricing        Pricing[]

  @@map("services")
}

model ServiceFeature {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  service_id          BigInt    @db.UnsignedBigInt
  feature_name        String    @db.VarChar(255)
  feature_description String?   @db.Text
  created_at          DateTime? @default(now()) @db.Timestamp(0)
  updated_at          DateTime? @updatedAt @db.Timestamp(0)
  service             Service   @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([service_id], map: "service_features_service_id_foreign")
  @@map("service_features")
}

model Pricing {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  service_id   BigInt    @db.UnsignedBigInt
  package_name String    @default("Standard") @db.VarChar(255)
  price        Decimal   @db.Decimal(15, 2)
  notes        String?   @db.Text
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  updated_at   DateTime? @updatedAt @db.Timestamp(0)
  service      Service   @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([service_id], map: "pricing_service_id_foreign")
  @@map("pricing")
}

model KnowledgeBase {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  category   String    @db.VarChar(50)
  title      String    @db.VarChar(255)
  content    String    @db.Text
  is_active  Boolean   @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @updatedAt @db.Timestamp(0)

  @@map("knowledge_base")
}

model Conversation {
  id         BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  session_id String     @unique @db.VarChar(255)
  user_name  String?    @db.VarChar(255)
  created_at DateTime?  @default(now()) @db.Timestamp(0)
  updated_at DateTime?  @updatedAt @db.Timestamp(0)
  messages   Message[]
  leads      Lead[]

  @@map("conversations")
}

model Message {
  id              BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  conversation_id BigInt       @db.UnsignedBigInt
  role            String       @db.VarChar(20)
  content         String       @db.Text
  created_at      DateTime     @default(now()) @db.Timestamp(0)
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id], map: "messages_conversation_id_foreign")
  @@map("messages")
}

model Lead {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  name            String        @db.VarChar(255)
  email           String?       @db.VarChar(255)
  phone           String?       @db.VarChar(255)
  business_type   String?       @db.VarChar(255)
  requirement     String?       @db.Text
  budget          String?       @db.VarChar(255)
  status          String        @default("new") @db.VarChar(50)
  conversation_id BigInt?       @db.UnsignedBigInt
  created_at      DateTime?     @default(now()) @db.Timestamp(0)
  updated_at      DateTime?     @updatedAt @db.Timestamp(0)
  conversation    Conversation? @relation(fields: [conversation_id], references: [id], onDelete: SetNull)

  @@index([conversation_id], map: "leads_conversation_id_foreign")
  @@map("leads")
}
